/* style.qss */

/* Main Background */
QMainWindow, QDialog {
    background-color: #2b2b2b;
    color: #e0e0e0;
}

/* Panels (Left, Right, Top, Bottom) */
QWidget#TopBar, QWidget#LeftToolbar, QWidget#RightAIPanel, QWidget#StatusBar {
    background-color: #1e1e1e;
}

/* General Buttons */
QPushButton {
    background-color: transparent;
    color: #e0e0e0;
    border: none;
    border-radius: 4px;
    padding: 6px;
}

QPushButton:hover {
    background-color: #3c3c3c;
}

QPushButton:disabled {
    color: #6f6f6f;
}

/* Primary Purple Button (OCR Detection) */
QPushButton#primaryPurpleBtn {
    background-color: #9b59ff;
    color: white;
    font-weight: bold;
}
QPushButton#primaryPurpleBtn:hover {
    background-color: #8a4de6;
}

/* Primary Blue Button */
QPushButton#primaryBlueBtn {
    background-color: #4a9eff;
    color: white;
    font-weight: bold;
}
QPushButton#primaryBlueBtn:hover {
    background-color: #3988e5;
}

/* Borders/Separators */
QFrame#HLine, QFrame#VLine {
    background-color: #3c3c3c;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #1e1e1e;
    width: 10px;
}
QScrollBar::handle:vertical {
    background: #3c3c3c;
    border-radius: 5px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: #4c4c4c;
}